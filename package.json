{
  "name": "mesh-orchestrator",
  "version": "0.2.2",
  "type": "module",
  "description": "Local multi-agent orchestration for Claude Code, Codex, Antigravity, and DSH",
  "bin": {
    "mesh": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm test",
    "doctor": "node src/cli.ts doctor",
    "test": "node --test test/*.test.ts",
    "check": "npm run build && node --test test/*.test.ts",
    "badges": "node scripts/badges.mjs",
    "web": "node src/cli.ts web"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roystars-04r/mesh.git"
  },
  "homepage": "https://github.com/roystars-04r/mesh#readme",
  "bugs": {
    "url": "https://github.com/roystars-04r/mesh/issues"
  },
  "keywords": [
    "multi-agent",
    "ai-agents",
    "orchestration",
    "claude-code",
    "codex",
    "cli",
    "workflow",
    "llm"
  ],
  "files": [
    "dist",
    "prompts",
    "fixtures",
    "mesh.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
